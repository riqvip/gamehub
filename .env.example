# Copy to /opt/stacks/gamehub/.env. Secrets live in individual files, not this file.
COMPOSE_PROJECT_NAME=gamehub
GAMEHUB_DATA_ROOT=/opt/data/gamehub
PALWORLD_DATA_ROOT=/opt/data/palworld/gamehub
GAMEHUB_SECRETS_ROOT=/opt/stacks/gamehub/secrets
ADMIN_USER=admin
# Obtain with: stat -c %g /var/run/docker.sock
DOCKER_GID=990
MANAGER_BIND_IP=127.0.0.1
MANAGER_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,homeserver
# Keep true for HTTPS/Tailscale Serve; false only for an isolated local HTTP test.
COOKIE_SECURE=true
ADMIN_ALLOWED_IPS=
# Empty: all proxy headers are ignored. Trust only your actual reverse proxy peers.
TRUSTED_PROXIES=
GAME_BIND_IP=127.0.0.1
GAME_MEMORY=16g
GAME_CPUS=4
# Resolved 2026-11-05; Linux amd64. Review new runtime images before changing.
PALWORLD_IMAGE=thijsvanloef/palworld-server-docker@sha256:07313feaecb42ecdea0b737ae922559dc5ab4c63d69275043f0943bd441fc35e
# Separate Windows/Wine runtime used only by explicitly converted or created modded instances.
PALWORLD_WINE_IMAGE=thijsvanloef/palworld-server-docker@sha256:911ec2b0fd9a3392e9ab687833344d3cda025998cce7dab11a943fa4cedb3e3f
INSTALL_BACKEND=depotdownloader
INSTALL_TIMEOUT_SECONDS=1800
# Exact HTTPS hosts, including each redirect host. Empty disables URL installation.
MOD_DOWNLOAD_HOSTS=
